# Generated by tools/lcars-gen from tokens/palette.json. Do not edit; edit the tokens.
$lcars_background     = rgb({{color.background|hex}})
$lcars_orange         = rgb({{color.orange|hex}})
$lcars_peach          = rgb({{color.peach|hex}})
$lcars_lavender       = rgb({{color.lavender|hex}})
$lcars_periwinkle     = rgb({{color.periwinkle|hex}})
$lcars_red            = rgb({{color.red|hex}})
$lcars_text_on_color  = rgb({{color.textOnColor|hex}})
$lcars_text_on_black  = rgb({{color.textOnBlack|hex}})

$lcars_border_active   = rgb({{role.borderActive|color|hex}})
$lcars_border_inactive = rgba({{role.borderInactive|color|hex}}{{role.borderInactiveAlpha|alpha}})
$lcars_group_active    = rgb({{role.groupActive|color|hex}})
$lcars_group_inactive  = rgb({{role.groupInactive|color|hex}})

$lcars_repo     = {{repo}}
$lcars_font     = {{font.family}}
$lcars_border   = {{shape.border}}
$lcars_rounding = {{shape.rounding}}
$lcars_gaps_in  = {{shape.gapsIn}}
$lcars_gaps_out = {{shape.gapsOut}}

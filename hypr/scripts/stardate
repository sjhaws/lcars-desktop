#!/bin/sh
# Print the Earth-date stardate used across LCARS: 1000 units per year since 1946.
# (The shell computes the same value in QML.)
set -- $(date '+%Y %j %H %M')
days=$(date -d "$1-12-31" +%j)
awk -v y="$1" -v d="$2" -v h="$3" -v m="$4" -v n="$days" \
  'BEGIN { printf "STARDATE %.1f\n", (y - 1946) * 1000 + 1000 * ((d - 1) + (h * 60 + m) / 1440) / n }'

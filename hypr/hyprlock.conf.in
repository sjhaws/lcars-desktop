# Generated by tools/lcars-gen from tokens/palette.json. Do not edit; edit hypr/hyprlock.conf.in.
# LCARS lock screen: elbow and sidebar on the left, clock, stardate and access code in the middle.

general {
    hide_cursor = true
    ignore_empty_input = true
}

animations {
    enabled = true
    bezier = lcars, 0.2, 0.9, 0.3, 1
    animation = fadeIn, 1, 3, lcars
    animation = fadeOut, 1, 3, lcars
}

background {
    monitor =
    color = rgb({{color.background|hex}})
}

# ---- frame. zindex sets the drawing order (higher on top); together they make an
# elbow with one rounded outer corner and a concave inner corner.
shape {   # top arm (its left end is hidden under the elbow)
    monitor =
    zindex = 1
    size = 82%, 36
    color = rgb({{color.orange|hex}})
    rounding = 18
    position = 200, -30
    halign = left
    valign = top
}
shape {   # concave inner corner: orange square...
    monitor =
    zindex = 2
    size = 24, 24
    color = rgb({{color.orange|hex}})
    position = 230, -66
    halign = left
    valign = top
}
shape {   # ...with a black quarter-circle cut out of it
    monitor =
    zindex = 3
    size = 48, 48
    color = rgb({{color.background|hex}})
    rounding = 24
    position = 230, -66
    halign = left
    valign = top
}
shape {   # elbow: rounded outer corner
    monitor =
    zindex = 4
    size = 200, 200
    color = rgb({{color.orange|hex}})
    rounding = 60
    position = 30, -30
    halign = left
    valign = top
}
shape {   # squares off the elbow's other corners
    monitor =
    zindex = 5
    size = 120, 200
    color = rgb({{color.orange|hex}})
    position = 110, -30
    halign = left
    valign = top
}
shape {
    monitor =
    zindex = 6
    size = 200, 120
    color = rgb({{color.orange|hex}})
    position = 30, -110
    halign = left
    valign = top
}
shape {
    monitor =
    zindex = 7
    size = 200, 70
    color = rgb({{color.peach|hex}})
    position = 30, -236
    halign = left
    valign = top
}
shape {
    monitor =
    zindex = 8
    size = 200, 70
    color = rgb({{color.lavender|hex}})
    position = 30, -312
    halign = left
    valign = top
}
shape {
    monitor =
    zindex = 9
    size = 200, 70
    color = rgb({{color.periwinkle|hex}})
    position = 30, -388
    halign = left
    valign = top
}
shape {
    monitor =
    zindex = 10
    size = 200, 70
    color = rgb({{color.red|hex}})
    position = 30, -464
    halign = left
    valign = top
}
shape {   # rounded foot of the sidebar
    monitor =
    zindex = 11
    size = 200, 36
    color = rgb({{color.orange|hex}})
    rounding = 18
    position = 30, 30
    halign = left
    valign = bottom
}

# ---- labels on the frame (black on color, like the shell's segments)
label {
    monitor =
    zindex = 50
    text = LCARS
    color = rgb({{color.textOnColor|hex}})
    font_size = 30
    font_family = {{font.family}}
    position = 130, -176
    halign = left
    valign = top
}
label {
    monitor =
    zindex = 50
    text = SECURITY
    color = rgb({{color.textOnColor|hex}})
    font_size = 20
    font_family = {{font.family}}
    position = 44, -270
    halign = left
    valign = top
}
label {
    monitor =
    zindex = 50
    text = ACCESS
    color = rgb({{color.textOnColor|hex}})
    font_size = 20
    font_family = {{font.family}}
    position = 44, -346
    halign = left
    valign = top
}
label {
    monitor =
    zindex = 50
    text = cmd[update:0] echo "$USER" | tr a-z A-Z
    color = rgb({{color.textOnColor|hex}})
    font_size = 20
    font_family = {{font.family}}
    position = 44, -422
    halign = left
    valign = top
}
label {
    monitor =
    zindex = 50
    text = LOCKED
    color = rgb({{color.textOnColor|hex}})
    font_size = 20
    font_family = {{font.family}}
    position = 44, -498
    halign = left
    valign = top
}
label {
    monitor =
    zindex = 50
    text = LCARS ACCESS TERMINAL
    color = rgb({{color.textOnColor|hex}})
    font_size = 20
    font_family = {{font.family}}
    position = -80, -33
    halign = right
    valign = top
}

# ---- center: time, stardate, access code
label {
    monitor =
    zindex = 50
    text = $TIME
    color = rgb({{color.textOnBlack|hex}})
    font_size = 140
    font_family = {{font.family}}
    position = 100, 150
    halign = center
    valign = center
}
label {
    monitor =
    zindex = 50
    text = cmd[update:60000] ~/.config/hypr/scripts/stardate
    color = rgb({{color.lavender|hex}})
    font_size = 32
    font_family = {{font.family}}
    position = 100, 30
    halign = center
    valign = center
}
input-field {
    monitor =
    zindex = 50
    size = 440, 60
    outline_thickness = {{shape.border}}
    rounding = 30
    outer_color = rgb({{color.orange|hex}})
    inner_color = rgb({{color.background|hex}})
    font_color = rgb({{color.textOnBlack|hex}})
    check_color = rgb({{color.periwinkle|hex}})
    fail_color = rgb({{color.red|hex}})
    font_family = {{font.family}}
    placeholder_text = <span foreground="##{{color.lavender|hex}}">ENTER ACCESS CODE</span>
    fail_text = ACCESS DENIED
    fade_on_empty = false
    dots_size = 0.25
    dots_spacing = 0.35
    position = 100, -80
    halign = center
    valign = center
}

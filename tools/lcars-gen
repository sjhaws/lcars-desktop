#!/usr/bin/env python3
"""Generate every themed file from tokens/palette.json (the single source of
colors, fonts and shape sizes).

Templates are `*.in` files; `{{path.to.value}}` is replaced by the token value,
with optional filters:
    {{color.orange|hex}}      -> ff9900          (Hyprland rgb()/rgba())
    {{color.orange|#}}        -> #ff9900
    {{role.borderInactive|color|hex}}            role names resolve to a color
    {{role.borderInactiveAlpha|alpha}}  -> 73    (0..1 -> two hex digits)
    {{frame.armHeight|plus:12}}         -> 40    (add a number)
    {{repo}}                            -> absolute path of this repo

Usage: tools/lcars-gen            (run by install.sh; rerun after editing tokens)
"""
import json, re, sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
TOKENS = json.loads((REPO / "tokens/palette.json").read_text())
TEMPLATES = {  # template -> output (outputs are gitignored)
    "hypr/colors.conf.in": "hypr/generated/colors.conf",
    "hypr/hyprlock.conf.in": "hypr/generated/hyprlock.conf",
}


def lookup(path):
    node = TOKENS
    for part in path.split("."):
        node = node[part]
    return node


def render(text):
    def sub(m):
        path, *filters = [p.strip() for p in m.group(1).split("|")]
        if path == "repo":
            value = str(REPO)
        else:
            value = lookup(path)
        for f in filters:
            if f == "color":
                value = TOKENS["color"][value]
            elif f == "hex":
                value = value.lstrip("#").lower()
            elif f == "#":
                value = "#" + value.lstrip("#").lower()
            elif f.startswith("plus:"):
                value = int(value) + int(f[5:])
            elif f == "alpha":
                value = f"{round(float(value) * 255):02x}"
            else:
                raise SystemExit(f"unknown filter {f!r} in {m.group(0)}")
        return str(value)
    return re.sub(r"\{\{([^}]+)\}\}", sub, text)


def main():
    # Interface sounds are generated too (original synthesis, see tools/lcars-sounds)
    import runpy
    runpy.run_path(str(REPO / "tools/lcars-sounds"), run_name="__main__")
    for src, dst in TEMPLATES.items():
        out = REPO / dst
        out.parent.mkdir(parents=True, exist_ok=True)
        # Write to a temp file and rename: Hyprland reloads its config as soon as a
        # file changes, and must never read a half-written one
        tmp = out.with_name(out.name + ".tmp")
        tmp.write_text(render((REPO / src).read_text()))
        tmp.replace(out)
        print(f"generated {dst}")


if __name__ == "__main__":
    sys.exit(main())

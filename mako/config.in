# Generated by tools/lcars-gen from tokens/palette.json. Do not edit.
# Stopgap notifications until the Quickshell shell (Phase 3).
font={{font.family}} SemiBold {{font.size}}
background-color={{color.background|#}}
text-color={{color.textOnBlack|#}}
border-color={{role.borderActive|color|#}}
border-size={{shape.border}}
border-radius={{shape.rounding}}
padding=12,16
margin={{shape.gapsOut}}
width=420
anchor=top-right
default-timeout=8000
max-icon-size=48

[urgency=low]
border-color={{color.periwinkle|#}}

[urgency=critical]
border-color={{color.red|#}}
default-timeout=0
